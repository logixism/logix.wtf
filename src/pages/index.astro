---
import ActivityCard from "../components/ActivityCard.astro";
import IntroCard from "../components/IntroCard.astro";
import ProjectsCard from "../components/ProjectsCard.astro";
import SocialsCard from "../components/SocialsCard.astro";
import PageLayout from "../layouts/PageLayout.astro";
import { getAverageImageColorServer } from "../server/image-color";
import { getPresenceService } from "../server/presence";
import { getActivityPresentation } from "../shared/activity-presentation";
import { getDiscordComponentEmbed } from "../shared/discord-component-embed";
import { getThemeBackgrounds } from "../shared/theme";

const presence = await getPresenceService().getPresence();
const presentation = getActivityPresentation(presence);
let themeColor = "#6750a4";

try {
  themeColor = await getAverageImageColorServer(presentation.avatarUrl);
} catch (error) {
  console.error("Could not derive server-rendered avatar theme color", error);
}

const themeBackgrounds = getThemeBackgrounds(themeColor);

const siteUrl = "https://logix.wtf/";
const avatarUrl = new URL(presentation.avatarUrl);
const avatarHash =
  avatarUrl.hostname === "cdn.discordapp.com"
    ? avatarUrl.pathname.match(/^\/avatars\/[^/]+\/([^/.]+)\.[^/]+$/)?.[1]
    : undefined;
const previewImageUrl = new URL(
  avatarHash === undefined
    ? "/avatar.webp"
    : `/avatar.webp?v=${encodeURIComponent(avatarHash)}`,
  siteUrl,
).toString();
const discordComponentEmbed = getDiscordComponentEmbed({
  presentation,
  themeColor,
  previewImageUrl,
  siteUrl,
});

const bootstrapState = JSON.stringify({ presence });
---

<PageLayout
  title="logix"
  description="my cool website"
  image={previewImageUrl}
  url={siteUrl}
  discordComponentEmbed={discordComponentEmbed}
  backgroundLight={themeBackgrounds.light}
  backgroundDark={themeBackgrounds.dark}
>
  <presence-controller data-state={bootstrapState}>
    <m3e-theme
      class="page-theme"
      color={themeColor}
      scheme="auto"
      motion="expressive"
    >
      <main class="site-main">
        <div class="card-grid">
          <IntroCard presentation={presentation} />
          <ActivityCard presentation={presentation} />
          <ProjectsCard />
          <SocialsCard />
        </div>
      </main>
    </m3e-theme>
  </presence-controller>
</PageLayout>

---
import { MONKEYTYPE_PROFILE_URL } from "../shared/profile";
import type { ActivityPresentation } from "../shared/activity-presentation";

interface Props {
  presentation: ActivityPresentation;
}

const { presentation } = Astro.props;
---

<m3e-card class="card intro-card" variant="filled">
  <div slot="content" class="intro-content">
    <div class="intro-copy">
      <div class="intro-top">
        <m3e-shape name="4-leaf-clover" class="lead-shape">
          <div class="shape-center">
            <m3e-icon name="waving_hand" variant="rounded"></m3e-icon>
          </div>
        </m3e-shape>
        <m3e-heading
          class="intro-heading"
          level="2"
          variant="display"
          size="large"
          emphasized
        >
          <span class="intro-heading-copy" aria-hidden="true">
            <span>hi! i'm</span>
            <span
              class="intro-name-shell"
              data-intro-name-shell
              data-name-index="0"
            >
              <span class="intro-name" data-intro-name>logix.wtf</span>
            </span>
          </span>
          <span class="sr-only"
            >hi! i'm logix.wtf, logixism, logix.lol, or logix.</span
          >
        </m3e-heading>
      </div>
      <p class="intro-blurb">
        <a
          class="certified-link"
          href={MONKEYTYPE_PROFILE_URL}
          target="_blank"
          rel="noreferrer"
          >Certified<m3e-icon name="arrow_outward" variant="rounded"
          ></m3e-icon></a
        >professional keyboard user
      </p>
    </div>
    <m3e-shape name="7-sided-cookie" class="avatar-shape">
      <m3e-avatar>
        <img
          data-avatar
          width="512"
          height="512"
          src={presentation.avatarUrl}
          alt="logix.wtf"
        />
      </m3e-avatar>
    </m3e-shape>
  </div>
</m3e-card>

<script>
  const introNames = ["logix.wtf", "logixism", "logix.lol", "logix"];
  const introName = document.querySelector<HTMLElement>("[data-intro-name]");
  const introNameShell = document.querySelector<HTMLElement>(
    "[data-intro-name-shell]",
  );
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (introName && introNameShell) {
    let nameIndex = 0;
    let rotationTimer: number | undefined;

    const swapName = async () => {
      nameIndex = (nameIndex + 1) % introNames.length;

      if (reducedMotion.matches) {
        introName.textContent = introNames[nameIndex];
        introNameShell.dataset.nameIndex = String(nameIndex);
        return;
      }

      const exitAnimation = introName.animate(
        [
          {
            opacity: 1,
            transform: "translateY(0) scale(1)",
            filter: "blur(0)",
          },
          {
            opacity: 0,
            transform: "translateY(-0.35em) scale(0.92)",
            filter: "blur(5px)",
          },
        ],
        {
          duration: 180,
          easing: "cubic-bezier(0.4, 0, 1, 1)",
          fill: "forwards",
        },
      );

      await exitAnimation.finished.catch(() => undefined);
      const previousWidth = introNameShell.getBoundingClientRect().width;

      introNameShell.style.width = "auto";
      introName.textContent = introNames[nameIndex];
      introNameShell.dataset.nameIndex = String(nameIndex);

      const nextWidth = introNameShell.getBoundingClientRect().width;
      introNameShell.style.width = `${previousWidth}px`;
      exitAnimation.cancel();

      const shellAnimation = introNameShell.animate(
        [
          {
            width: `${previousWidth}px`,
            transform: "scale(0.96)",
          },
          {
            width: `${nextWidth}px`,
            transform: "scale(1.04)",
            offset: 0.65,
          },
          {
            width: `${nextWidth}px`,
            transform: "scale(1)",
          },
        ],
        {
          duration: 520,
          easing: "cubic-bezier(0.2, 0.9, 0.25, 1)",
          fill: "forwards",
        },
      );

      void shellAnimation.finished.finally(() => {
        introNameShell.style.width = "";
        shellAnimation.cancel();
      });

      const enterAnimation = introName.animate(
        [
          {
            opacity: 0,
            transform: "translateY(0.4em) scale(0.92)",
            filter: "blur(5px)",
          },
          {
            opacity: 1,
            transform: "translateY(0) scale(1)",
            filter: "blur(0)",
          },
        ],
        {
          duration: 420,
          easing: "cubic-bezier(0.16, 1, 0.3, 1)",
          fill: "forwards",
        },
      );

      void enterAnimation.finished.finally(() => enterAnimation.cancel());
    };

    const startRotation = () => {
      window.clearInterval(rotationTimer);
      rotationTimer = window.setInterval(swapName, 2800);
    };

    startRotation();
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) {
        window.clearInterval(rotationTimer);
      } else {
        startRotation();
      }
    });
  }
</script>

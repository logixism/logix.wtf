---
import "../styles.css";
import { INITIAL_THEME_SCRIPT } from "../shared/initial-theme";

interface Props {
  backgroundDark: string;
  backgroundLight: string;
  description: string;
  discordComponentEmbed: Record<string, unknown>;
  image: string;
  title: string;
  url: string;
}

const {
  backgroundDark,
  backgroundLight,
  description,
  discordComponentEmbed,
  image,
  title,
  url,
} = Astro.props;
---

<!doctype html>
<html
  lang="en"
  data-background-dark={backgroundDark}
  data-background-light={backgroundLight}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:url" content={url} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta
      name="theme-color"
      content={backgroundLight}
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content={backgroundDark}
      media="(prefers-color-scheme: dark)"
    />
    <title>{title}</title>
    <script
      id="discord:component-embed"
      type="application/json"
      is:inline
      set:html={JSON.stringify(discordComponentEmbed)}
    ></script>

    <script is:inline set:html={INITIAL_THEME_SCRIPT}></script>
    <script>
      import "../client";
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Google+Sans+Flex:opsz,wght@6..144,1..1000&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
